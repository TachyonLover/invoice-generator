<Window x:Class="InvoiceGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvoiceGen"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Invoice Generator"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Customer Name"/>
            <TextBox x:Name="CustomerNameTextBox"
                     Height="30"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Customer Address"/>
            <TextBox x:Name="CustomerAddressTextBox"
                     Height="30"
                     Margin="0,5,0,15"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,20,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Item"/>
                <TextBox x:Name="DescriptionTextBox"
             Height="30"
             Margin="0,5,0,0"/>
                <DataGrid x:Name="ItemsDataGrid"
          AutoGenerateColumns="False"
          Margin="0,20,0,0"
          IsReadOnly="True">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item"
                            Binding="{Binding Description}"
                            Width="*"/>

                        <DataGridTextColumn Header="Quantity"
                            Binding="{Binding Quantity}"
                            Width="100"/>

                        <DataGridTextColumn Header="Unit Price"
                            Binding="{Binding PricePerUnit}"
                            Width="120"/>

                        <DataGridTextColumn Header="Total"
                            Binding="{Binding Total}"
                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Quantity"/>
                <TextBox x:Name="QuantityTextBox"
             Height="30"
             Margin="0,5,0,0"/>
            </StackPanel>


            <StackPanel Grid.Column="2">
                <TextBlock Text="Unit Price"/>
                <TextBox x:Name="PriceTextBox"
                Height="30"
                Margin="0,5,0,0"/>

                <Button Content="Add Item"
                Width="100"
                Height="30"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="AddItem_Click"/>



            </StackPanel>


        </Grid>




    <Button Grid.Row="3"
                Content="Generate PDF"
                Width="150"
                Height="40"
                HorizontalAlignment="Right"/>
        
    </Grid>
</Window>
