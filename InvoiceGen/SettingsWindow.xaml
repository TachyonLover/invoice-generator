<Window x:Class="InvoiceGen.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="600"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,25"/>

        <!-- Settings fields -->
        <StackPanel Grid.Row="1">

            <TextBlock Text="Business Name"/>
            <TextBox x:Name="BusinessNameTextBox"
                     Height="30"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Business Address"/>
            <TextBox x:Name="BusinessAddressTextBox"
                     Height="30"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Phone"/>
            <TextBox x:Name="PhoneTextBox"
                     Height="30"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Email"/>
            <TextBox x:Name="EmailTextBox"
                     Height="30"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Currency"/>
            <ComboBox x:Name="CurrencyComboBox"
                      Height="30"
                      Margin="0,5,0,15"
                      SelectedIndex="0">

                <ComboBoxItem Content="USD"/>
                <ComboBoxItem Content="EUR"/>
                <ComboBoxItem Content="GBP"/>
                <ComboBoxItem Content="JPY"/>

            </ComboBox>

            <TextBlock Text="Appearance"/>
            <ComboBox x:Name="AppearanceComboBox"
                      Height="30"
                      Margin="0,5,0,15"
                      SelectedIndex="0">

                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>

            </ComboBox>

        </StackPanel>

        <!-- Save button -->
        <Button Grid.Row="2"
                Content="Save Settings"
                Width="130"
                Height="38"
                HorizontalAlignment="Right"
                Click="SaveSettings_Click"/>

    </Grid>

</Window>